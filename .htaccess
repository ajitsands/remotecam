# Apache Server Configuration
# SandS CamGuard Security Settings

# Disable Directory Indexing
Options -Indexes

# Protect sensitive data files from direct HTTP viewing
# (JSON state files, session data, security logs, local PIN file)
<FilesMatch "\.(json|log|txt)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block direct web access to the local PIN file even if data/.htaccess is disabled
<FilesMatch "^pin\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow main PHP entry points
DirectoryIndex index.php

# Reverse Proxy for MediaMTX Streaming (Enables 100% HTTPS WebRTC & HLS)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^stream/webrtc/(.*)$ http://127.0.0.1:8889/$1 [P,L]
    RewriteRule ^stream/hls/(.*)$ http://127.0.0.1:8888/$1 [P,L]
</IfModule>
